# Copy this file to .env and adjust.

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/weft
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/weft?retryWrites=true&w=majority

PORT=3000

# Set to 1 when running behind a reverse proxy or a host like Render or Railway,
# so rate limiting sees the real visitor IP.
TRUST_PROXY=0

# Razorpay credentials (keep the secret private)
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Used to sign account session cookies. Set a long random value in production.
AUTH_SECRET=replace-with-a-long-random-secret
